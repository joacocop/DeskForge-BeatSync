{
  "name": "deskforge-beatsync",
  "version": "1.0.0",
  "description": "Suite de productividad con reproductor musical interactivo para escritorio.",
  "author": "DeskForge",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.deskforge.beatsync",
    "productName": "DeskForge + BeatSync",
    "directories": {
      "output": "dist-installer/e9-e10"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskForge + BeatSync"
    }
  }
}
